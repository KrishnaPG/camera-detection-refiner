{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handdetect-run-event.schema.json",
  "title": "HandDetect Run Event",
  "type": "object",
  "x-berg10": {
    "kind": "raw_source_payload"
  },
  "x-berg10.kind": "raw_source_schema",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "family",
    "idempotency_key",
    "run_suite_id",
    "run_id",
    "source_kind",
    "package_id",
    "created_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": ["run_started", "clip_processed", "artifact_ready", "run_completed", "run_failed"]
    },
    "family": {
      "type": "string",
      "enum": ["b_runtime_status", "b_artifact"]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "run_suite_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "clip_id": {
      "type": ["string", "null"]
    },
    "source_kind": {
      "const": "handdetect_quality_run"
    },
    "package_id": {
      "const": "handdetect_quality_adapter"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": ["string", "null"]
    },
    "artifact_path": {
      "type": ["string", "null"]
    },
    "message": {
      "type": ["string", "null"]
    }
  }
}
